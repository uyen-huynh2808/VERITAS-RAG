{
  "schema_contract": {
    "doc_id_pattern": "^\\d+/\\d{4}/(NĐ-CP|TT-[A-Z]+|QH\\d+|QĐ-[A-Z]+|NQ-[A-Z]+)$",
    "required_fields": [
      "doc_id",
      "title",
      "issued_date",
      "effective_from"
    ],
    "allowed_doc_types": [
      "Nghị định",
      "Thông tư",
      "Luật",
      "Quyết định",
      "Nghị quyết"
    ]
  },

  "temporal_contract": {
    "intra_document": {
      "enabled": true,
      "effective_from_on_or_after_issued": true,
      "effective_to_after_effective_from": true
    },

    "cross_document": {
      "enabled": true,
      "relations": {
        "amends": {
          "issued_after_target": true,
          "effective_after_target": true
        },
        "replaces": {
          "issued_after_target": true,
          "effective_after_target": true
        }
      }
    }
  },

  "quality_contract": {
    "max_null_ratio": 0.05,
    "min_diacritic_ratio": 0.85,
    "max_ocr_noise_ratio": 0.02,

    "table_integrity": {
      "require_headers": true,
      "max_broken_cells_ratio": 0.05,
      "check_merged_cells": true
    }
  },

  "provenance_contract": {
    "hash_algorithm": "sha256",
    "require_storage_path": true,
    "require_document_hash": true,
    "require_chunk_page_number": true,
    "require_chunk_hash": true
  }
}