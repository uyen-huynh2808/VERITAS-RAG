{
  "schema_contract": {
    "doc_id_pattern": "^(?:\\d+/\\d{4}/(NĐ-CP|TT-[A-Z]+|QH\\d+|QĐ-[A-Za-z]+|NQ-[A-Z]+)|DOC-[0-9a-f]{24})$",
    "required_fields": [
      "doc_id",
      "title",
      "issued_date",
      "effective_from"
    ],
    "allowed_doc_types": [
      "Nghị định",
      "Thông tư",
      "Luật",
      "Quyết định",
      "Nghị quyết"
    ]
  },
  "temporal_contract": {
    "intra_document": {
      "enabled": true,
      "effective_from_on_or_after_issued": true,
      "effective_to_after_effective_from": true
    },
    "cross_document": {
      "enabled": true,
      "relations": {
        "amends": {
          "issued_after_target": true,
          "effective_after_target": true,
          "target_must_end_by_source_effective": false
        },
        "replaces": {
          "issued_after_target": true,
          "effective_after_target": true,
          "target_must_end_by_source_effective": true
        },
        "repeals": {
          "issued_after_target": true,
          "effective_after_target": true,
          "target_must_end_by_source_effective": true
        }
      }
    }
  },
  "quality_contract": {
    "max_null_ratio": 0.05,
    "min_diacritic_density": 0.1,
    "max_ocr_noise_ratio": 0.02,
    "max_corrupted_token_ratio": 0.02,
    "table_integrity": {
      "require_headers": true,
      "max_broken_cells_ratio": 0.05,
      "check_merged_cells": true,
      "check_structured_cells": true,
      "max_empty_cells_ratio": 0.1,
      "check_year_columns": true
    },
    "structure_integrity": {
      "enabled": true,
      "reject_duplicate_article_numbers": true,
      "reject_duplicate_provision_ids": true,
      "reject_duplicate_article_content": true,
      "reject_repeated_article_headings": true,
      "min_duplicate_content_tokens": 20
    }
  },
  "provenance_contract": {
    "hash_algorithm": "sha256",
    "require_storage_path": true,
    "require_document_hash": true,
    "require_article_id": true,
    "require_chunk_page_number": true,
    "require_chunk_hash": true,
    "require_provision_id": true,
    "reject_duplicate_chunk_ids": true,
    "reject_duplicate_chunk_content": true,
    "min_duplicate_chunk_tokens": 40
  }
}
